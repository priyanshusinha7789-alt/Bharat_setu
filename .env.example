# BHASHA SETU - Gemini AI Configuration
# Get your Gemini API keys from Google AI Studio: https://aistudio.google.com/app/apikey

# Multi-Key Failover Pool (Recommended):
# Configure multiple keys so the server automatically fails over when one key hits rate limits (429).
GEMINI_API_KEY_1=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here

# Legacy Single Key (Fallback if indexed keys are not set):
# GEMINI_API_KEY=your_gemini_api_key_here
